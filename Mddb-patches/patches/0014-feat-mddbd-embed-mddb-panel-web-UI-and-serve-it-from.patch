diff --git a/services/mddbd/ui_embed.go b/services/mddbd/ui_embed.go
new file mode 100644
index 0000000..e3d1222
--- /dev/null
+++ b/services/mddbd/ui_embed.go
@@ -0,0 +1,19 @@
+package main
+
+import "embed"
+
+// webui holds the pre-built mddb-panel static assets, embedded into the
+// binary so a single mddbd.exe serves both the JSON API and the web UI with
+// zero external dependencies (no Node, no separate static server).
+//
+// The directory is populated at CI build time by copying
+// services/mddb-panel/dist into services/mddbd/webui. A non-dotfile
+// placeholder.txt is committed so this package still compiles when the panel
+// has not been built (e.g. the windows-runtime test job). Note: //go:embed
+// ignores files whose names begin with '.' or '_', so a .gitkeep would NOT
+// be embeddable and the directory would appear empty — hence placeholder.txt.
+// In that case only placeholder.txt is embedded and the UI handler falls
+// through to the API handler for unknown routes.
+//
+//go:embed webui
+var webuiFS embed.FS
diff --git a/services/mddbd/ui_handler.go b/services/mddbd/ui_handler.go
new file mode 100644
index 0000000..f2fb399
--- /dev/null
+++ b/services/mddbd/ui_handler.go
@@ -0,0 +1,123 @@
+package main
+
+import (
+	"io"
+	"io/fs"
+	"mime"
+	"net/http"
+	"path"
+	"strings"
+)
+
+// uiAPIPrefixes are path prefixes owned by the API/control plane. They must
+// never be served from the embedded web UI — unknown API paths should reach
+// the real handlers (and ultimately 404) rather than the SPA fallback.
+var uiAPIPrefixes = []string{
+	"/health",
+	"/v1/",
+	"/graphql",
+	"/playground",
+	"/metrics",
+	"/debug/",
+}
+
+// withEmbeddedUI wraps the API handler so that non-API routes are served from
+// the embedded webui FS, with SPA fallback to index.html for client-side
+// routing. API routes always take precedence and are delegated untouched.
+//
+// If the embedded UI is not present (only placeholder.txt), an unknown
+// non-API path falls through to the inner handler, which returns 404.
+func withEmbeddedUI(inner http.Handler) http.Handler {
+	sub, err := fs.Sub(webuiFS, "webui")
+	if err != nil {
+		// webui is embedded literally; this should never happen.
+		return inner
+	}
+
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		path := r.URL.Path
+		if isAPIPath(path) {
+			inner.ServeHTTP(w, r)
+			return
+		}
+
+		// Try the exact file first (assets, index.html, etc.).
+		rel := strings.TrimPrefix(path, "/")
+		if rel == "" {
+			rel = "index.html"
+		}
+		if f, err := sub.Open(rel); err == nil {
+			if info, err := f.Stat(); err == nil && !info.IsDir() {
+				f.Close()
+				serveEmbedded(w, r, sub, rel)
+				return
+			}
+			f.Close()
+		}
+
+		// SPA fallback: serve index.html for any other non-API path so deep
+		// links work. If index.html isn't embedded, fall through to the API
+		// handler (404).
+		if idx, err := sub.Open("index.html"); err == nil {
+			if info, err := idx.Stat(); err == nil && !info.IsDir() {
+				idx.Close()
+				serveEmbedded(w, r, sub, "index.html")
+				return
+			}
+			idx.Close()
+		}
+
+		inner.ServeHTTP(w, r)
+	})
+}
+
+// serveEmbedded serves name from the embedded FS directly. We deliberately do
+// NOT use http.FileServer(http.FS(sub)) here: for embedded directory-style
+// paths it issues a 301 "Location: ./" redirect instead of serving the file.
+// Opening the file ourselves and using http.ServeContent gives deterministic
+// 200 responses (with range/304 support) and correct Content-Type.
+func serveEmbedded(w http.ResponseWriter, r *http.Request, fsys fs.FS, name string) {
+	if strings.Contains(name, ".") {
+		// Has a file extension (asset, not a route) — cacheable.
+		w.Header().Set("Cache-Control", "public, max-age=3600")
+	}
+	f, err := fsys.Open(name)
+	if err != nil {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	if info.IsDir() {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	ctype := mime.TypeByExtension(path.Ext(name))
+	if ctype == "" {
+		ctype = "application/octet-stream"
+	}
+	w.Header().Set("Content-Type", ctype)
+	// fs.File is an io.Reader but not (statically) an io.ReadSeeker. embed.FS
+	// files implement Seek, so assert to get http.ServeContent's range/304
+	// support; if that ever fails, fall back to a plain copy.
+	if rs, ok := f.(io.ReadSeeker); ok {
+		http.ServeContent(w, r, info.Name(), info.ModTime(), rs)
+		return
+	}
+	if r.Method != http.MethodHead {
+		io.Copy(w, f)
+	}
+}
+
+func isAPIPath(path string) bool {
+	for _, p := range uiAPIPrefixes {
+		if strings.HasPrefix(path, p) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/services/mddbd/ui_handler_test.go b/services/mddbd/ui_handler_test.go
new file mode 100644
index 0000000..f2c1400
--- /dev/null
+++ b/services/mddbd/ui_handler_test.go
@@ -0,0 +1,59 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestIsAPIPath(t *testing.T) {
+	api := []string{"/health", "/v1/search", "/v1/health", "/graphql", "/playground", "/metrics", "/debug/pprof/", "/v1/mcp/config"}
+	ui := []string{"/", "/index.html", "/assets/app.js", "/marker-icon.png", "/some/spa/route"}
+
+	for _, p := range api {
+		if !isAPIPath(p) {
+			t.Errorf("isAPIPath(%q) = false, want true", p)
+		}
+	}
+	for _, p := range ui {
+		if isAPIPath(p) {
+			t.Errorf("isAPIPath(%q) = true, want false", p)
+		}
+	}
+}
+
+// TestEmbeddedUIDelegatesAPIPaths verifies that API routes are never served
+// from the embedded FS, even when the embedded UI is absent (only .gitkeep).
+func TestEmbeddedUIDelegatesAPIPaths(t *testing.T) {
+	inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusTeapot)
+		w.Write([]byte("api:" + r.URL.Path))
+	})
+	h := withEmbeddedUI(inner)
+
+	for _, path := range []string{"/v1/search", "/graphql", "/health", "/metrics"} {
+		req := httptest.NewRequest(http.MethodGet, path, nil)
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != http.StatusTeapot {
+			t.Errorf("path %q: got status %d, want %d (delegated to API)", path, rec.Code, http.StatusTeapot)
+		}
+	}
+}
+
+// TestEmbeddedUIFallbackNoIndex verifies that, when the embedded UI has no
+// index.html (panel not built), unknown non-API paths fall through to the
+// inner handler rather than 500-ing.
+func TestEmbeddedUIFallbackNoIndex(t *testing.T) {
+	inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+	})
+	h := withEmbeddedUI(inner)
+
+	req := httptest.NewRequest(http.MethodGet, "/some/spa/route", nil)
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusNotFound {
+		t.Errorf("got status %d, want 404 (fall through to API)", rec.Code)
+	}
+}
diff --git a/services/mddbd/webui/placeholder.txt b/services/mddbd/webui/placeholder.txt
new file mode 100644
index 0000000..72928ec
--- /dev/null
+++ b/services/mddbd/webui/placeholder.txt
@@ -0,0 +1,12 @@
+This file exists only so the embedded `webui` directory is never empty at
+compile time.
+
+Go's //go:embed directive ignores files whose names begin with '.' or '_'
+(so a .gitkeep would NOT be embedded, leaving the directory with "no
+embeddable files" and failing to compile). A plain non-dotfile like this one
+is always embeddable.
+
+When the panel is not built (e.g. the windows-runtime `go test` job), this is
+the only file in webui and the package still compiles; the UI handler falls
+through to the API handler for unknown routes. CI overwrites webui/ with the
+built panel dist before cross-compiling mddbd.exe.
-- 
