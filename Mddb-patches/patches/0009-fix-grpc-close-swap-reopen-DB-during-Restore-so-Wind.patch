From 1dadef4959851cc19c7f1e2a62d52d92d975d564 Mon Sep 17 00:00:00 2001
From: Rajendertyagi <86180775+Rajendertyagi@users.noreply.github.com>
Date: Fri, 7 Aug 2026 21:03:23 +0530
Subject: [PATCH 09/13] fix(grpc): close+swap+reopen DB during Restore under
 restoreMu (Windows)

GRPCServer.Restore copied the backup over the live, open bbolt file.
Unix allows renaming over an open file; Windows forbids removing an open
file, so restore failed with 'being used by another process'. Mirror the
GO-004 withRestoreLock pattern: hold the exclusive restoreMu write lock for
the whole close->copy->reopen so concurrent readers drain and the handle is
swapped atomically (not just on single-threaded Restore). Then reassign the
pointer and reset the binlog.
---
 services/mddbd/grpc_server.go | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/services/mddbd/grpc_server.go b/services/mddbd/grpc_server.go
index 5e74a0e..f233f16 100644
--- a/services/mddbd/grpc_server.go
+++ b/services/mddbd/grpc_server.go
@@ -489,7 +489,32 @@ func (g *GRPCServer) Restore(ctx context.Context, req *proto.RestoreRequest) (*p
 		return nil, status.Error(codes.InvalidArgument, err.Error())
 	}
 
-	if err := copyFile(safeFrom, g.server.Path); err != nil {
+	// Swap the live DB under the exclusive restore lock (GO-004): this drains
+	// in-flight readers and blocks new ones for the whole close->copy->reopen,
+	// and is required on Windows where an open file cannot be removed/renamed.
+	if err := g.server.withRestoreLock(func() error {
+		// Close the live DB so the file can be swapped (required on Windows,
+		// where an open file cannot be removed/renamed).
+		if err := g.server.DB.Close(); err != nil {
+			return fmt.Errorf("close db: %w", err)
+		}
+		if err := copyFile(safeFrom, g.server.Path); err != nil {
+			return err
+		}
+		// Reopen the DB in place; restore the same pointer so the server keeps using it.
+		db, err := bolt.Open(g.server.Path, 0600, getOptimizedBoltOptions())
+		if err != nil {
+			return fmt.Errorf("reopen db: %w", err)
+		}
+		g.server.DB = db
+		// Reset binlog after restore to force followers to re-snapshot.
+		if g.server.Binlog != nil {
+			if err := g.server.Binlog.Rotate(0); err != nil {
+				log.Printf("Warning: failed to reset binlog after restore: %v", err)
+			}
+		}
+		return nil
+	}); err != nil {
 		return nil, status.Error(codes.Internal, err.Error())
 	}
 
-- 
