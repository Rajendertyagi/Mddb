# MDDB Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
MDDB_PATH=/data/mddb.db
MDDB_MODE=wr

# Server Configuration
MDDB_ADDR=:11023
MDDB_GRPC_ADDR=:11024

# Authentication (set MDDB_AUTH_ENABLED=false to disable)
MDDB_AUTH_ENABLED=true
MDDB_AUTH_JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
MDDB_AUTH_JWT_EXPIRY=24h
MDDB_AUTH_ADMIN_USERNAME=admin
MDDB_AUTH_ADMIN_PASSWORD=changeme

# Features
MDDB_METRICS=true
MDDB_EXTREME=false

# Vector Search / Embeddings (optional)
# Options: openai, ollama, voyage
MDDB_EMBEDDING_PROVIDER=ollama
MDDB_EMBEDDING_API_URL=http://ollama:11434
MDDB_EMBEDDING_API_KEY=
MDDB_EMBEDDING_MODEL=nomic-embed-text
MDDB_EMBEDDING_DIMENSIONS=768

# Panel Configuration
VITE_MDBB_SERVER=localhost:11023
NODE_ENV=development
