# MDDB Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
MDDB_PATH=/data/mddb.db
MDDB_MODE=wr

# Server Configuration
MDDB_ADDR=:11023
MDDB_GRPC_ADDR=:11024

# Authentication (set MDDB_AUTH_ENABLED=false to disable)
MDDB_AUTH_ENABLED=true
MDDB_AUTH_JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
MDDB_AUTH_JWT_EXPIRY=24h
MDDB_AUTH_ADMIN_USERNAME=admin
MDDB_AUTH_ADMIN_PASSWORD=changeme

# Features
MDDB_METRICS=true
# When MDDB_AUTH_ENABLED=true, /metrics requires credentials by default (SEC-009).
# Set MDDB_METRICS_PUBLIC=true to expose /metrics without auth (e.g. a trusted
# network where Prometheus cannot send a Bearer token). Has no effect when auth
# is disabled — /metrics is already open in that case.
MDDB_METRICS_PUBLIC=false
MDDB_EXTREME=false
# Max request body size in bytes for /v1/* JSON endpoints (SEC-005). Oversized
# requests get HTTP 413. /v1/upload and /v1/import-wiki are exempt (they stream
# large files). Default 32 MiB.
MDDB_MAX_BODY_BYTES=33554432
# Wiki import (/v1/import-wiki) safety caps (SEC-006). Decompressed-byte budget
# bounds a bz2 decompression bomb; page cap bounds total imported pages. Raise
# both for full Wikipedia dumps.
MDDB_WIKI_MAX_DECOMPRESSED_BYTES=4294967296
MDDB_WIKI_MAX_PAGES=500000

# Vector Search / Embeddings (optional)
# Options: openai, ollama, voyage
MDDB_EMBEDDING_PROVIDER=ollama
MDDB_EMBEDDING_API_URL=http://ollama:11434
MDDB_EMBEDDING_API_KEY=
MDDB_EMBEDDING_MODEL=nomic-embed-text
MDDB_EMBEDDING_DIMENSIONS=768

# Panel Configuration
VITE_MDBB_SERVER=localhost:11023
NODE_ENV=development
