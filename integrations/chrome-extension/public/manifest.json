{
  "manifest_version": 3,
  "name": "MDDB Browser",
  "short_name": "MDDB",
  "version": "0.1.0",
  "description": "Connect to an MDDB server from the toolbar — view live document counts, jump to the admin panel, and store URL/API key locally.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "MDDB Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
