# eslint-plugin-react@7.37.5 (latest) still peers eslint "<=^9.7" and has not yet
# published eslint 10 support, while this package is on eslint ^10. The plugin works
# correctly with eslint 10 at runtime (lint passes) — only its declared peer range
# lags. Accept the conservative-but-functional resolution so `npm ci` / `npm install`
# succeed deterministically across npm 10 (CI) and npm 11 (local). Revisit and remove
# once eslint-plugin-react ships an eslint-10-compatible peer range.
legacy-peer-deps=true
