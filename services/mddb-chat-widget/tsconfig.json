{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"],
  "//": "Test files run via `node --test` (Node type-stripping); exclude them from the production tsc build so node:test/.ts-extension imports don't fail it.",
  "exclude": ["src/**/*.test.ts"]
}
